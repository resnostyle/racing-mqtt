# Mosquitto
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home/racing
MQTT_CLIENT_ID=racing-mqtt
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PREFIX=homeassistant

# Lightsouts API series slugs (comma-separated)
RACING_SERIES_SLUGS=wec,imsa-sportscar-championship,wrc,supercars-championship

# Session categories: practice, qualifying, sprint, race, other
RACING_CATEGORIES=race,qualifying

# Polling (seconds); shortens to 30s within 5 minutes of session start/end
RACING_POLL_INTERVAL_SECONDS=900
RACING_UPCOMING_DAYS=90

LOG_LEVEL=INFO

# Formula Drift (ICS or formulad.com schedule)
DRIFT_ENABLED=true
DRIFT_SOURCE=formulad
# DRIFT_SOURCE=ics
# DRIFT_ICS_URL=https://driftcalendar.com/driftcal.ics
# DRIFT_FORMULAD_URL=https://www.formulad.com/schedule

OPENWEC_ENABLED=true
OPENWEC_BASE_URL=https://api.openwec.com/api/v1
# OPENWEC_API_KEY=           # optional; required only for laps/stints analytics
OPENWEC_RESULTS_LOOKBACK_DAYS=30

# Virginia International Raceway (virnow.com/events)
VIR_ENABLED=true
# VIR_EVENTS_URL=https://virnow.com/events/
# VIR_WP_POSTS_URL=https://virnow.com/wp-json/wp/v2/posts
# VIR_WP_CATEGORY_ID=81
